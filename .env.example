# Copy to .env and fill in. Generate strong values with:
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | cut -c1-32   # passwords
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-50   # AUTHENTIK_SECRET_KEY

# PostgreSQL — superuser "postgres"
POSTGRES_PASSWORD=

# MySQL — "root"
MYSQL_ROOT_PASSWORD=

# SQL Server — "sa"
MSSQL_SA_PASSWORD=

# Redis
REDIS_PASSWORD=

# RabbitMQ — admin account
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=

# Authentik
AUTHENTIK_SECRET_KEY=
